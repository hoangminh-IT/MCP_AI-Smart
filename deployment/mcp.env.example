# Nonsecret template. Set the same first-party JWT/DB secrets as API through a private store.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
Mcp__AllowedHosts__0=mcp.inventory.example
Mcp__AllowedOrigins__0=https://inventory.example
Mcp__RateLimitPermitLimit=120
Jwt__Issuer=https://inventory.example
Jwt__Audience=inventory-first-party
Jwt__AccessTokenMinutes=30
Jwt__SigningKey=
ConnectionStrings__DefaultConnection=
