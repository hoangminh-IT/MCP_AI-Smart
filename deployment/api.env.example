# Nonsecret template. Set real secrets privately; .NET does not load this file automatically.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
AllowedHosts=api.inventory.example
Cors__AllowedOrigins__0=https://inventory.example
Mcp__ServerUrl=https://mcp.inventory.example/mcp
Mcp__TimeoutSeconds=30
Mcp__UseSharedFirstPartyAudience=true
Jwt__Issuer=https://inventory.example
Jwt__Audience=inventory-first-party
Jwt__AccessTokenMinutes=30
Jwt__SigningKey=
ConnectionStrings__DefaultConnection=
Llm__Provider=OpenAICompatible
Llm__BaseUrl=https://api.groq.com/openai/v1
Llm__Model=openai/gpt-oss-20b
# GPT-OSS supports low/medium/high; low favors latency for inventory queries.
Llm__ReasoningEffort=low
# Only classified request-rate errors with Retry-After may be retried once.
Llm__MaxRateLimitRetries=1
Llm__RequestTimeoutSeconds=120
Llm__ApiKey=
